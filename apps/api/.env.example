PORT=3000
CORS_ORIGINS=http://localhost:5173
COGNITO_USER_POOL_ID=us-east-1_kCc9mo8FP
COGNITO_CLIENT_ID=2vvuu6ucikoeidtdc6sl4kapl1
# Local development: an in-memory Postgres (data is lost on restart).
# For a real database: DATABASE_URL=postgres://user:pass@host:5432/db and DB_SSL=disable for a local server.
DATABASE_URL=memory
# Copy users that exist in Cognito but not in the database (the in-memory one starts empty).
SYNC_USERS_ON_START=true
# Users' private files (resumes): the dev bucket (Job-apply-infrastructure live/dev/persistent).
USER_FILES_BUCKET=job-apply-dev-user-files-418272768931
# Gmail job-email inbox (optional): a Google OAuth "Web application" client whose
# authorized redirect URI is http://localhost:5173/gmail/callback. Put the real
# values in .env (git-ignored), never here.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# 32 random bytes, base64 (openssl rand -base64 32). Without it, a new key is made
# at each start, so connections don't survive a restart (fine with DATABASE_URL=memory).
# GMAIL_TOKEN_KEY=
