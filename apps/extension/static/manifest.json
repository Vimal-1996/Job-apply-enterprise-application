{
  "manifest_version": 3,
  "name": "Job Apply",
  "version": "0.1.0",
  "description": "Fills job applications on Greenhouse and Lever from your Job Apply profile. You review and submit.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["identity", "sidePanel", "storage", "tabs"],
  "host_permissions": [
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "https://*.cloudfront.net/*",
    "https://*.amazoncognito.com/*",
    "https://*.amazonaws.com/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Job Apply" },
  "side_panel": { "default_path": "panel.html" },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://*.greenhouse.io/*", "https://jobs.lever.co/*", "https://jobs.eu.lever.co/*"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
